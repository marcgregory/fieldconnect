{
  "name": "@fieldconnect/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv-cli -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint ok'",
    "db:migrate": "npx --yes dotenv-cli -e ../../.env -- node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migration-file-language sql --migrations-dir ./src/db/migrations --no-envfile",
    "db:rollback": "npx --yes dotenv-cli -e ../../.env -- node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down --migration-file-language sql --migrations-dir ./src/db/migrations --no-envfile"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/static": "^7.0.0",
    "@fieldconnect/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.27.0",
    "jose": "^6.2.3",
    "node-pg-migrate": "^7.0.0",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
