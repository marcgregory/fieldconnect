{
  "name": "@fieldconnect/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint ok'",
    "db:migrate": "node-pg-migrate up --migration-file-language sql --migrations-dir ./src/db/migrations --envfile ../../.env",
    "db:rollback": "node-pg-migrate down --migration-file-language sql --migrations-dir ./src/db/migrations --envfile ../../.env"
  },
  "dependencies": {
    "fastify": "^4.27.0",
    "@fastify/cors": "^9.0.0",
    "pg": "^8.12.0",
    "node-pg-migrate": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.0",
    "@fieldconnect/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.7.0",
    "pino-pretty": "^11.0.0"
  }
}
