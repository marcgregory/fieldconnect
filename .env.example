# Database
DATABASE_URL=postgres://user:password@localhost:5432/fieldconnect

# Auth
JWT_SECRET=change-this-to-a-random-secret
NEXTAUTH_SECRET=change-this-to-another-random-secret
NEXTAUTH_URL=http://localhost:3000

# API
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3000

# Email
# EMAIL_PROVIDER: preview | resend | console
#   - preview: writes rendered HTML to .emails/*.html (dev only)
#   - console: logs only, no files (useful in CI)
#   - resend:  real transactional email via Resend (production)
EMAIL_PROVIDER=preview
EMAIL_FROM=FieldConnect <noreply@fieldconnect.app>
APP_URL=http://localhost:3000
# Required only when EMAIL_PROVIDER=resend
RESEND_API_KEY=
