# ⚠️  SECURITY WARNING
# Never commit .env or .env.*.local to version control.
# All credentials must be injected via environment variables at deployment time.
# See README.md for secure credential setup instructions.

# Database
# For Render: DATABASE_URL is auto-provided in dashboard — copy it here
# For local: Create a PostgreSQL database and set connection string
# NEVER use default username/password in production
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@localhost:5432/fieldconnect

# Auth
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-a-random-secret-for-each-environment>
NEXTAUTH_SECRET=<generate-a-random-secret-for-each-environment>
NEXTAUTH_URL=http://localhost:3000

# API
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3000

# Cloudinary
# Get credentials from Cloudinary dashboard at https://cloudinary.com/console
# NEVER commit your real credentials to version control
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_API_SECRET>
CLOUDINARY_FOLDER=fieldconnect

# Email
# EMAIL_PROVIDER: preview | resend | console
#   - preview: writes rendered HTML to .emails/*.html (dev only)
#   - console: logs only, no files (useful in CI)
#   - resend:  real transactional email via Resend (production)
EMAIL_PROVIDER=preview
EMAIL_FROM=FieldConnect <noreply@fieldconnect.app>
APP_URL=http://localhost:3000
# Required only when EMAIL_PROVIDER=resend
# Get from Resend dashboard at https://resend.com
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
